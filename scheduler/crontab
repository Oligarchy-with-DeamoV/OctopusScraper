# OctopusScraper 定时任务配置
# 格式: 分 时 日 月 周  命令
# ──────────────────────────────────────────────────────────

# 每 30 分钟触发 scraper
0,30 * * * * curl -sf -X POST http://octopus-service:8000/trigger_scraper 2>&1 | logger -t trigger_scraper

# 每 1 分钟触发 upload
* * * * * curl -sf -X POST http://octopus-service:8000/trigger_upload 2>&1 | logger -t trigger_upload

# 每 1 小时刷新配置
0 * * * * curl -sf -X POST http://octopus-service:8000/admin/config/refresh 2>&1 | logger -t config_refresh

# ──────────────────────────────────────────────────────────
# 添加更多定时任务只需在下方新增一行，例如：
# */5 * * * * curl -sf -X POST http://octopus-service:8000/some_other_task 2>&1 | logger -t some_other_task
# 0 */2 * * * curl -sf -X POST http://octopus-service:8000/cleanup 2>&1 | logger -t cleanup
