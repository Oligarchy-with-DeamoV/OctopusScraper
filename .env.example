# Notion API Configuration
NOTION_API_KEY=your_notion_integration_token_here
NOTION_SCRAPERS_DATABASE_ID=your_scrapers_database_id_here
NOTION_CONTENT_DATABASE_ID=your_content_database_id_here

# Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=plain

# Configuration Management
CONFIG_REFRESH_INTERVAL=300

# Scraping Configuration
SCRAPER_TIMEOUT=10
UPLOAD_TIMEOUT=15
UPLOAD_MAX_RETRIES=3

# Content Processing Configuration
# Maximum length for RSS feed summary. If exceeded, summary will be empty and processed by LLM
OCTOPUS_SUMMARY_MAX_LENGTH=500

# Task Manager Configuration (Always Enabled)
MAX_CONCURRENT_TASKS=8
MAX_QUEUE_SIZE=1000
RESULT_RETENTION_HOURS=48

# Scheduler Configuration (Optional)
# Enable/disable the TaskScheduler functionality
ENABLE_SCHEDULER=false
# Automatically start the scheduler when service starts
AUTO_START_SCHEDULER=false
# Maximum number of concurrent scheduled tasks
MAX_CONCURRENT_SCHEDULES=10
# Interval (in seconds) for checking scheduled tasks
SCHEDULE_CHECK_INTERVAL=60

# Health Check Configuration
# Skip Notion connectivity check in readiness probe (useful for faster health checks)
HEALTHCHECK_SKIP_NOTION=false

# Environment Configuration
ENVIRONMENT=development
