# Notion API Configuration
NOTION_API_KEY="your_notion_api_key_here"
NOTION_CONTENT_DATABASE_ID="your_content_database_id"
NOTION_SYNC_ENABLED=false
NOTION_SYNC_INTERVAL_SECONDS=60
NOTION_SYNC_BATCH_SIZE=100
NOTION_SYNC_MAX_ATTEMPTS=10
NOTION_SYNC_LEASE_SECONDS=300

# PostgreSQL canonical storage
POSTGRES_DB=octopus
POSTGRES_USER=octopus
POSTGRES_PASSWORD=octopus
DB_HOST=localhost
DB_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=10

# Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
OCTOPUS_DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=plain

# Scraper configuration directory
SCRAPER_CONFIG_DIR=resources/scrapers.d
SCRAPER_CONFIG_POLL_INTERVAL=1
SCRAPER_CONFIG_DEBOUNCE_SECONDS=0.75

# Scraping Configuration
SCRAPER_TIMEOUT=10
UPLOAD_TIMEOUT=15
UPLOAD_MAX_RETRIES=3

# Content Processing Configuration
# Maximum length for RSS feed summary. If exceeded, summary will be empty and processed by LLM
OCTOPUS_SUMMARY_MAX_LENGTH=500

# RSSHub Configuration
XUEQIU_COOKIES="your_xueqiu_cookies_here"

# Vector Alert System Configuration
FEISHU_WEBHOOK_URL="https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_key_here"
VECTOR_LOG=info
