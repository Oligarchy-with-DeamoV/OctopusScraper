# Notion API Configuration
NOTION_API_KEY="your notion api key"
NOTION_CONTENT_DATABASE_ID="your notion database id"
NOTION_SCRAPERS_DATABASE_ID="your notion database id"

# Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
OCTOPUS_DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=plain

# Configuration Management
CONFIG_REFRESH_INTERVAL=300

# Scraping Configuration
SCRAPER_TIMEOUT=10
UPLOAD_TIMEOUT=15
UPLOAD_MAX_RETRIES=3

# RSSHub fetcher HTTP timeouts (seconds). Both default to the values
# previously hard-coded in the RSSHub fetcher (10s connect, 1200s read).
# Tune them down if you want failing RSSHub requests to give up sooner.
RSSHUB_CONNECT_TIMEOUT=10
RSSHUB_READ_TIMEOUT=1200

# Content Processing Configuration
# Maximum length for RSS feed summary. If exceeded, summary will be empty and processed by LLM
OCTOPUS_SUMMARY_MAX_LENGTH=500

# Vector Monitor
FEISHU_WEBHOOK_URL="your feishu webhook"
