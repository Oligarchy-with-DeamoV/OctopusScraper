# Notion API Configuration
NOTION_API_KEY="your notion api key"
NOTION_CONTENT_DATABASE_ID="your notion database id"
NOTION_SYNC_ENABLED=false
NOTION_SYNC_INTERVAL_SECONDS=60
NOTION_SYNC_BATCH_SIZE=100
NOTION_SYNC_MAX_ATTEMPTS=10
NOTION_SYNC_LEASE_SECONDS=300
NOTION_UPLOAD_RETRY_DELAY=30

# PostgreSQL canonical storage
POSTGRES_DB=octopus
POSTGRES_USER=octopus
POSTGRES_PASSWORD="replace-with-a-strong-password"
DB_HOST=host.docker.internal
DB_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=10

# Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
OCTOPUS_DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=plain
ENVIRONMENT=production
OCTOPUS_TASK_RESULT_PATH=/app/.octopus/task_results.sqlite3

# Scraper configuration directory
SCRAPER_CONFIG_DIR=/etc/octopus-scraper/scrapers.d
SCRAPER_CONFIG_POLL_INTERVAL=1
SCRAPER_CONFIG_DEBOUNCE_SECONDS=0.75

# Task manager
TASK_MANAGER_MAX_CONCURRENT=3
TASK_MANAGER_MAX_QUEUE_SIZE=1000
RESULT_RETENTION_HOURS=48

# Scraping Configuration
SCRAPER_TIMEOUT=10
UPLOAD_TIMEOUT=15
UPLOAD_MAX_RETRIES=3

# RSSHub fetcher HTTP timeouts (seconds). Both default to the values
# previously hard-coded in the RSSHub fetcher (10s connect, 1200s read).
# Tune them down if you want failing RSSHub requests to give up sooner.
RSSHUB_CONNECT_TIMEOUT=10
RSSHUB_READ_TIMEOUT=1200

# Content Processing Configuration
# Maximum RSS feed summary length; longer summaries are truncated with an ellipsis.
OCTOPUS_SUMMARY_MAX_LENGTH=500

# OpenAI-compatible LLM processors. Per-scraper YAML values may override these.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL_NAME="gpt-3.5-turbo"

# RSSHub credentials
XUEQIU_TOKEN=""

# Vector Monitor
FEISHU_WEBHOOK_URL="your feishu webhook"
VECTOR_LOG=info
